{
  "framework": null,
  "installCommand": "npx --yes pnpm@10.34.6 install --frozen-lockfile",
  "buildCommand": "npx --yes pnpm@10.34.6 --filter @workspace/teamup run build",
  "outputDirectory": "artifacts/teamup/dist/public",
  "functions": {
    "api/index.ts": {
      "maxDuration": 60
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.ts"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}